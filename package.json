  "dependencies": {
    "preact": "11.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "fsevents": false
  }
}
