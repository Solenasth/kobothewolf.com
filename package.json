{
  "name": "kobothewolf.com",
  "version": "0.4.0",
  "private": true,
  "description": "Bilingual profile and KOBO.EXE card editor, a static site on GitHub Pages",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "predev": "npm run gen",
    "dev": "vite",
    "gen": "node scripts/gen-validators.ts",
    "prevalidate": "npm run gen",
    "validate": "node scripts/validate.ts",
    "prebuild": "npm run validate",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run gen",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "pretest": "npm run gen",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:playwright-image": "node scripts/check-playwright-image.ts"
  },
  "dependencies": {
    "html-to-image": "1.11.13",
    "jspdf": "4.2.1",
    "preact": "11.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "jsqr": "1.4.0",
    "lightningcss": "1.33.0",
    "parse5": "8.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "fsevents": false
  }
}
