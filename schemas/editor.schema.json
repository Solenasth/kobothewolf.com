{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kobothewolf.com/schemas/editor.schema.json",
  "title": "Style editor lists",
  "description": "Keys only; labels come from the style catalogs. Ranges other than escala are derived from tokens.json (DESIGN §3.3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["acentos", "sombras", "fondos", "arte", "escala"],
  "properties": {
    "acentos": { "$ref": "#/$defs/colors" },
    "sombras": { "$ref": "#/$defs/colors" },
    "fondos": { "$ref": "#/$defs/keys" },
    "arte": { "$ref": "#/$defs/keys" },
    "escala": {
      "type": "array",
      "prefixItems": [{ "type": "integer", "minimum": 10 }, { "type": "integer", "maximum": 300 }],
      "items": false,
      "minItems": 2
    }
  },
  "$defs": {
    "colors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^#[0-9A-F]{6}$" } },
    "keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 }
    }
  }
}
